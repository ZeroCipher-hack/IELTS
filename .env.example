DOMAIN=ieltsqa.example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=ieltsqa.example.com,backend
CSRF_TRUSTED_ORIGINS=https://ieltsqa.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_TRUST_PROXY=1

# Server only. Never prefix a secret with NEXT_PUBLIC_.
AI_ENABLED=0
GEMINI_API_KEY=
GEMINI_WRITING_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional ungraded voice practice for signed-in students (staff can test without this).
VOICE_PRACTICE_ENABLED=0
