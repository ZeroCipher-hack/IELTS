{$DOMAIN} {
    encode zstd gzip
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    # Uploaded exam audio. Django does not serve media outside DEBUG, so the proxy does.
    handle_path /media/* {
        root * /srv/media
        file_server
    }
    @django path /api/* /admin /admin/*
    handle @django {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
